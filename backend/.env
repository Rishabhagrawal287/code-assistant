# ─────────────────────────────────────────────────────────────────────────────
#  Code Assistant Backend – Environment Variables
#  Copy this file to .env and fill in values.  .env is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true                          # set false in production

# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL of your local Ollama daemon (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model used for code completion & explanation.
# Recommended free options (pull with: ollama pull <name>):
#   codellama:7b          – fastest, ~4 GB VRAM
#   codellama:13b         – better quality, ~8 GB VRAM
#   llama3.2:latest   – excellent at code, ~4 GB VRAM
#   deepseek-coder:33b    – best quality, ~20 GB VRAM
OLLAMA_MODEL=llama3.2:latest

# Generation parameters
OLLAMA_TEMPERATURE=0.1               # low = more deterministic for code
OLLAMA_NUM_PREDICT=400               # max tokens to generate
OLLAMA_CONTEXT_WINDOW=8192           # model context length

# ── Embeddings ────────────────────────────────────────────────────────────────
# HuggingFace model used for code embeddings (runs 100 % locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu                 # or "cuda" if you have a GPU

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_store    # relative to backend/ directory
CHROMA_COLLECTION_NAME=codebase

# ── Code Search ───────────────────────────────────────────────────────────────
# Max number of similar code chunks returned by semantic search
SEARCH_TOP_K=5
# Chunk size in tokens when indexing source files
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (the VS Code webview uses vscode-webview://)
CORS_ORIGINS=vscode-webview://,http://localhost:3000
